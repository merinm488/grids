# ================================================
# GRIDS - Git Ignore Configuration
# ================================================

# Environment variables
.env
.env.local
.env.*.local

# Node modules (if using npm for local development)
node_modules/
package-lock.json
yarn.lock

# Vercel
.vercel/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Build outputs
dist/
build/
.cache/

# Temporary files
*.tmp
*.temp
*.bak

# User-specific spreadsheet data (local testing)
# Uncomment if you don't want to commit test data
# *.json
# *.xlsx
# *.csv
.vercel

# Development database (user data storage)
db/
