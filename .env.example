# ================================================
# GRIDS - Environment Configuration Example
# ================================================
# Copy this file to .env for local development
# This file is for reference only - values shown are examples
#
# For Vercel deployment, set these in Vercel dashboard:
# Project Settings → Environment Variables

# ================================================
# Authentication Configuration (PRODUCTION)
# ================================================
# These environment variables are used for secure key hashing

# The actual pepper value (NEVER expose this to client-side code)
# Generate a strong, unique value for production
AUTH_PEPPER=your_production_pepper_change_this_value

# Pepper identifier (used to select which pepper to use)
AUTH_PEPPER_NAME=grids_primary_pepper_v1

# ================================================
# TextDB Configuration
# ================================================
# Get your collection ID from https://textdb.dev/

TEXTDB_COLLECTION_ID=your_collection_id_here
TEXTDB_API_KEY=your_api_key_if_required

# ================================================
# Application Settings
# ================================================

APP_NAME=Grids
APP_VERSION=1.0.0

# Default theme: 'light' or 'dark'
DEFAULT_THEME=light

# Auto-save interval in milliseconds
AUTO_SAVE_INTERVAL=30000

# ================================================
# Development Settings
# ================================================

# Force production mode for testing (true/false)
FORCE_PRODUCTION=false

# Enable debug logging (true/false)
DEBUG=false

# ================================================
# Security Notes
# ================================================
# - AUTH_PEPPER is only used server-side in Vercel functions
# - Client-side code never sees the actual pepper value
# - For local development, a hardcoded pepper is used
# - Always use HTTPS in production to protect keys in transit
# - Never commit actual pepper values to git
