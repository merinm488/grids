# ================================================
# GRIDS - Environment Configuration Example
# ================================================
# Copy this file to .env for local development
# This file is for reference only - values shown are examples
#
# For Vercel deployment, set these in Vercel dashboard:
# Project Settings → Environment Variables

# ================================================
# Authentication Configuration
# ================================================
# This is the ONLY environment variable required for production
# The pepper is used for secure key hashing (same as Notes project)

# Generate a strong, unique value for production
# Use: openssl rand -base64 32
PEPPER_SECRET=your_production_pepper_change_this_value

# ================================================
# Application Settings
# ================================================

APP_NAME=Grids
APP_VERSION=1.0.0

# Default theme: 'light' or 'dark'
DEFAULT_THEME=light

# Auto-save interval in milliseconds
AUTO_SAVE_INTERVAL=30000

# ================================================
# Development Settings
# ================================================

# Force production mode for testing (true/false)
FORCE_PRODUCTION=false

# Enable debug logging (true/false)
DEBUG=false

# ================================================
# Security Notes
# ================================================
# - PEPPER_SECRET is only used server-side in Vercel functions
# - Client-side code never sees the actual pepper value
# - For local development, a hardcoded pepper is used
# - TextDB is used directly with user hash as identifier
# - No additional TextDB configuration needed
# - Always use HTTPS in production to protect keys in transit
# - Never commit actual pepper values to git
